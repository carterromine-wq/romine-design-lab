# Local development only. Copy to .env and set your own teacher password.
# Never commit .env, credentials, or the data directory.
NODE_ENV=development
PORT=3000
DATA_DIR=./data
TEACHER_USERNAME=mrromine
# Required: at least 12 characters. Use a unique, strong password.
TEACHER_PASSWORD=

# On Render this defaults to RENDER_EXTERNAL_URL. Set only for a custom domain.
# PUBLIC_ORIGIN=https://your-classroom-domain.example

# Optional Google Identity Services sign-in. Leave unset to keep it disabled.
# Create a Web application OAuth client; see docs/GOOGLE_SIGN_IN.md.
# This is the public client ID, not a client secret. No Google client secret is used.
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Optional: restrict Google sign-ins to one Google Workspace hosted domain.
# Ask school IT for the actual student hosted domain; do not infer it from teacher email.
# Applies to Google only. Class-code/password signup remains available.
# GOOGLE_ALLOWED_DOMAIN=students.school.example
