# Local development only. Copy to .env and set your own teacher password.
# Never commit .env, credentials, or the data directory.
NODE_ENV=development
PORT=3000
DATA_DIR=./data
TEACHER_USERNAME=mrromine
# Required: at least 12 characters. Use a unique, strong password.
TEACHER_PASSWORD=

# On Render this defaults to RENDER_EXTERNAL_URL. Set only for a custom domain.
# PUBLIC_ORIGIN=https://your-classroom-domain.example
